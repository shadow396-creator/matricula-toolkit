# Matricula Toolkit Konfiguration
# Kopiere diese Datei nach .env und passe die Werte an

# Basis-URL des Matricula-Viewers (ohne ?pg=)
MATRICULA_BASE_URL=https://data.matricula-online.eu/de/slovenia/maribor/maribor-sv-janez-krstnik/01519/

# Buch-Kennzeichen für Dateinamen
MATRICULA_BOOK=01519

# Ausgabeverzeichnis für heruntergeladene Bilder
MATRICULA_OUT_DIR=./downloads

# Wartezeit pro Seite in Sekunden (entspricht der bewährten Methode: 5s)
MATRICULA_WAIT_SECONDS=5

# Timeout pro Seite in Millisekunden
MATRICULA_TIMEOUT_MS=60000

# Browser im Headless-Modus starten (true/false)
MATRICULA_HEADLESS=true

# Viewport-Breite für den Browser
MATRICULA_VIEWPORT_WIDTH=1920

# Viewport-Höhe für den Browser
MATRICULA_VIEWPORT_HEIGHT=1080

# Maximale Anzahl paralleler Downloads (1 = sequentiell, bewährte Methode)
MATRICULA_MAX_PARALLEL=1

# Maximale Dateigröße in Bytes (0 = unbegrenzt)
MATRICULA_MAX_FILE_SIZE=0

# Maximale Anzahl Seiten pro Download-Lauf (0 = unbegrenzt)
MATRICULA_MAX_PAGES=0

# --- OCR-Lastschutz (Schwellenwerte, 0 oder unset = deaktiviert) ---

# Maximale CPU-Auslastung in Prozent für OCR-Ausführung (0 = deaktiviert)
MATRICULA_OCR_MAX_CPU_PERCENT=85.0

# Maximale RAM-Auslastung in Prozent für OCR-Ausführung (0 = deaktiviert)
MATRICULA_OCR_MAX_RAM_PERCENT=85.0

# Maximale CPU-Temperatur in °C für OCR-Ausführung (unset = deaktiviert)
# MATRICULA_OCR_MAX_TEMP_C=80.0

# Timeout für OCR-Jobs in Sekunden
MATRICULA_OCR_TIMEOUT_SECONDS=300